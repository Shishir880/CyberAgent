# CyberAgent Environment Configuration
# ========================================

# LLM Provider Configuration (Ollama / Groq / OpenAI / DeepSeek / Gemini)
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=cyberagent-3b:latest

# System & Workspace Roots
WORKSPACE_ROOT=.
STORAGE_DIR=storage

# Execution Limits
MAX_STEPS=25
HITL_ENABLED=true

# Optional External API Keys
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# SHODAN_API_KEY=
# VIRUSTOTAL_API_KEY=

